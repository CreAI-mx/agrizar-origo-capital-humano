{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://creai.mx/schemas/agrizar/capital-humano/organization.schema.json",
  "title": "Organization",
  "description": "Current state of the MD-2 organization tree (GRZR-31) as `GET /api/organization` returns it: áreas, roles, equipos, people, role assignments and team memberships, with when the data is from. Seed and bulk-load files use organization-import.schema.json instead.",
  "type": "object",
  "required": ["dataAsOf", "lastChangedBy", "isTestData", "orgUnits", "roles", "teams", "people", "roleAssignments", "teamMemberships"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "dataAsOf": {
      "oneOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }],
      "description": "When the organization last changed. Null while nothing has been loaded."
    },
    "lastChangedBy": {
      "oneOf": [{ "type": "string" }, { "type": "null" }],
      "description": "Display name of who made that last change, or the actor id when it is not a person (the seed)."
    },
    "isTestData": {
      "oneOf": [{ "type": "boolean" }, { "type": "null" }],
      "description": "True when every load applied so far declared its content invented; false when at least one did not, so real people may be present; null before any load. The Back Office header says which."
    },
    "orgUnits": { "type": "array", "items": { "$ref": "#/$defs/orgUnit" } },
    "roles": { "type": "array", "items": { "$ref": "#/$defs/role" } },
    "teams": { "type": "array", "items": { "$ref": "#/$defs/team" } },
    "people": { "type": "array", "items": { "$ref": "#/$defs/person" } },
    "roleAssignments": { "type": "array", "items": { "$ref": "#/$defs/roleAssignment" } },
    "teamMemberships": { "type": "array", "items": { "$ref": "#/$defs/teamMembership" } }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "code": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
      "description": "Business code. Compared trimmed, case-insensitive."
    },
    "orgUnit": {
      "type": "object",
      "required": ["id", "code", "name", "kind", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "code": { "$ref": "#/$defs/code" },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["empresa", "direccion", "area", "subarea"] },
        "parentId": {
          "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }],
          "description": "Null only for the single root."
        },
        "sortOrder": { "type": "integer" },
        "status": { "enum": ["active", "inactive"] }
      }
    },
    "role": {
      "type": "object",
      "required": ["id", "code", "name", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "code": { "$ref": "#/$defs/code" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "level": {
          "oneOf": [
            {
              "enum": [
                "director",
                "gerente",
                "jefe",
                "coordinador",
                "lider",
                "supervisor",
                "especialista",
                "analista",
                "auxiliar",
                "practicante"
              ]
            },
            { "type": "null" }
          ]
        },
        "isSystem": { "type": "boolean", "default": false },
        "status": { "enum": ["active", "inactive"] }
      }
    },
    "team": {
      "type": "object",
      "required": ["id", "orgUnitId", "code", "name", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "orgUnitId": { "$ref": "#/$defs/id" },
        "code": { "$ref": "#/$defs/code" },
        "name": { "type": "string", "minLength": 1 },
        "leadPersonId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "status": { "enum": ["active", "inactive"] }
      }
    },
    "person": {
      "type": "object",
      "required": ["id", "displayName", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "displayName": { "type": "string", "minLength": 1 },
        "account": { "oneOf": [{ "type": "string", "format": "email" }, { "type": "null" }] },
        "employeeNumber": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
        "status": { "enum": ["active", "inactive"] }
      }
    },
    "roleAssignment": {
      "type": "object",
      "required": ["id", "personId", "roleId", "orgUnitId", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "personId": { "$ref": "#/$defs/id" },
        "roleId": { "$ref": "#/$defs/id" },
        "orgUnitId": {
          "$ref": "#/$defs/id",
          "description": "Scope root: covers this área and all its descendants."
        },
        "jobTitle": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
        "status": { "enum": ["active", "revoked"] }
      }
    },
    "teamMembership": {
      "type": "object",
      "required": ["id", "teamId", "personId", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "teamId": { "$ref": "#/$defs/id" },
        "personId": { "$ref": "#/$defs/id" },
        "status": { "enum": ["active", "removed"] }
      }
    }
  }
}
